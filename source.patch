+def yaz0_decode(data, label):
+    """解开动森 Shader/*.szs 的 Yaz0 封装。
+    Decode the Yaz0 wrapper used by ACNH Shader/*.szs.
+    """
+    if len(data) < 16: raise ValueError(f'{label}: truncated Yaz0 header')
+    size = struct.unpack_from('>I', data, 4)[0]
+    if size > 1 << 31: raise ValueError(f'{label}: Yaz0 output exceeds 2 GiB')
+    out = bytearray(); pos = 16; bits = 0; flags = 0
+    def take(n):
+        nonlocal pos
+        if pos + n > len(data): raise ValueError(f'{label}: truncated Yaz0 stream')
+        result = data[pos:pos + n]; pos += n; return result
+    while len(out) < size:
+        if not bits: flags = take(1)[0]; bits = 8
+        if flags & 0x80: out.extend(take(1))
+        else:
+            a, b = take(2); distance = ((a & 15) << 8 | b) + 1
+            count = (a >> 4) + 2 if a >> 4 else take(1)[0] + 18
+            if distance > len(out): raise ValueError(f'{label}: Yaz0 back-reference before output')
+            if len(out) + count > size: raise ValueError(f'{label}: Yaz0 back-reference exceeds output size')
+            # 重叠回引重复距离内的字节，不可用一次不重叠的切片代替。
+            # Overlapping references repeat the distance-sized pattern, not a single non-overlapping slice.
+            seed = out[len(out) - distance:]
+            out.extend((seed * ((count + distance - 1) // distance))[:count])
+        flags = flags << 1 & 255; bits -= 1
+    return bytes(out)
+
